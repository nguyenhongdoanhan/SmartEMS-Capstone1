# SmartEMS Caller - cấu hình môi trường
# Copy file này thành `.env` rồi sửa giá trị.
# File `.env` KHÔNG BAO GIỜ được commit lên git (chứa key/token).

# true = chạy với dữ liệu GIẢ LẬP (không cần backend) | false = gọi backend THẬT qua API_URL
EXPO_PUBLIC_MOCK_MODE=true

# Backend FastAPI (10.0.2.2 = localhost của máy tính nhìn từ Android emulator)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/ws

# Google Maps API key (để trống vẫn chạy được trên Expo Go / iOS Simulator)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
